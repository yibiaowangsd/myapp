<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <package android:name="com.huawei.health" />
        <package android:name="com.huawei.hwid" />
        <intent><action android:name="com.huawei.hms.core.aidlservice" /></intent>
        <intent><action android:name="com.huawei.health.action.KIT_SERVICE" /></intent>
    </queries>
    <application>
        <meta-data android:name="com.huawei.hms.client.appid" android:value="${huaweiAppId}" />
    </application>
</manifest>
